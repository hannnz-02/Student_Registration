<Window x:Class="Student_Registration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="Student Registration"
        Height="750"
        Width="1100"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="BurlyWood"
                Padding="20"
                CornerRadius="20 0 0 20">
            <StackPanel VerticalAlignment="Center">
                <fa:ImageAwesome Icon="UserCircle"
                                 Width="80"
                                 Height="80"
                                 Foreground="#E0F7FA"
                                 Margin="0,0,0,20"/>

                <TextBlock Text="Student Registration"
                           TextAlignment="Center"
                           FontWeight="Bold"
                           FontSize="18"
                           Foreground="White"/>

                <TextBlock TextWrapping="Wrap"
                           FontSize="13"
                           TextAlignment="Center"
                           Foreground="AliceBlue"
                           Margin="0,15,0,0"
                           Text="Welcome! Fill in your details to register as a new student."/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Padding="25"
                Background="White"
                CornerRadius="0 20 20 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Content="✕" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top"
                        Width="30" 
                        Height="30" 
                        Background="Transparent" 
                        BorderBrush="Transparent"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#888888"
                        Cursor="Hand"
                        Click="BtnClose_Click"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">

                        <TextBlock Text="Student Registration"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="NIM" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNim" Height="38" FontSize="15" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                        <TextBlock Text="Nama Mahasiswa" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNama" Height="38" FontSize="15" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                        <TextBlock Text="Tanggal Lahir" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DatePicker x:Name="dpTanggalLahir" Height="38" FontSize="15" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                        <TextBlock Text="Nomor Telepon" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNoTelp" Height="38" FontSize="15" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                        <TextBlock Text="Alamat" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtAlamat" Height="60" FontSize="15" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

                        <TextBlock Text="Program Studi" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbProdi" Height="38" FontSize="15" VerticalContentAlignment="Center" Margin="0,0,0,12">
                            <ComboBoxItem Content="Teknik Informatika"/>
                            <ComboBoxItem Content="Sistem Informasi"/>
                            <ComboBoxItem Content="Manajemen"/>
                            <ComboBoxItem Content="Akuntansi"/>
                        </ComboBox>

                        <TextBlock Text="Jenis Kelamin" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <RadioButton x:Name="rbLaki" Content="Laki-laki" FontSize="15" Margin="0,0,25,0"/>
                            <RadioButton x:Name="rbPerempuan" Content="Perempuan" FontSize="15"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button x:Name="btnSimpan"
                                    Content="Simpan"
                                    Width="120"
                                    Height="38"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Margin="0,0,15,0"
                                    Click="BtnSimpan_Click"/>

                            <Button x:Name="btnReset"
                                    Content="Reset"
                                    Width="100"
                                    Height="38"
                                    FontSize="15"
                                    Background="#E0E0E0"
                                    Click="BtnReset_Click"/>
                        </StackPanel>

                        <Separator Margin="0,10,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Daftar Mahasiswa Terdaftar" FontSize="18" FontWeight="Bold"/>
                             
                                <TextBlock x:Name="txtCounter" Text="Total Mahasiswa: 0" FontSize="14" Foreground="#555555" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="btnEdit"
                                        Content="Edit Data"
                                        Width="100"
                                        Height="32"
                                        FontSize="13"
                                        Margin="0,0,10,0"
                                        Background="#1976D2"
                                        Foreground="White"
                                        Click="BtnEdit_Click"/>

                                <Button x:Name="btnHapus"
                                        Content="Hapus Data"
                                        Width="100"
                                        Height="32"
                                        FontSize="13"
                                        Foreground="White"
                                        Background="#D32F2F"
                                        Click="BtnHapus_Click"/>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Cari:" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="txtSearch" 
                                     Height="35" 
                                     FontSize="14" 
                                     VerticalContentAlignment="Center" 
                                     TextChanged="TxtSearch_TextChanged"/>
                        </DockPanel>

                        <ListBox x:Name="lstMahasiswa" 
                                 Height="180"
                                 FontSize="14"
                                 BorderBrush="#DDDDDD"
                                 SelectionChanged="LstMahasiswa_SelectionChanged"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>